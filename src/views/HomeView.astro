---
import MainLayout from '@/layouts/MainLayout.astro';
import HeroSection from '@components/sections/landing/HeroSection.astro';
import HeroSectionAlt from '@components/sections/landing/HeroSectionAlt.astro';
import FeaturesGeneral from '@components/sections/features/FeaturesGeneral.astro';
import FeaturesNavs from '@components/sections/features/FeaturesNavs.astro';
import PricingSection from '@components/sections/pricing/PricingSection.astro';
import FAQ from '@components/sections/misc/FAQ.astro';
import AnnouncementBanner from '@components/ui/banners/AnnouncementBanner.astro';
import ToolCard from '@/components/tools/ToolCard.astro';
import ToolCategoryCard from '@/components/tools/ToolCategoryCard.astro';
import PrimaryCTA from '@components/ui/buttons/PrimaryCTA.astro';
import { CATEGORIES, featuredTools } from '@/data/tools';
import heroImage from '@images/kunda-hero-gemini.jpg';
import featureImage from '@images/kunda-brand-board.jpg';
import construction from '@images/construction-image.avif';
import tools from '@images/automated-tools.avif';
import dashboard from '@images/dashboard-image.avif';
import { getCopy } from '@/copy';
import { localePath, type MarketingLocale } from '@utils/locale';

/** The home page in one locale. Copy comes from the locale's copy table. */
interface Props {
  locale: MarketingLocale;
}

const { locale } = Astro.props;
const t = getCopy(locale);
const copy = t.home;
---

<MainLayout>
  <AnnouncementBanner
    btnId="dismiss-button"
    btnTitle={copy.banner}
    url={localePath(locale, '/tools')}
  />

  {/* Authentic Hero Section without fabricated social proof */}
  <HeroSection
    title={copy.hero.title}
    subTitle={copy.hero.subTitle}
    primaryBtn={copy.hero.primaryBtn}
    primaryBtnURL={localePath(locale, '/products')}
    secondaryBtn={copy.hero.secondaryBtn}
    secondaryBtnURL={localePath(locale, '/tools')}
    withReview={false}
    src={heroImage}
    alt={copy.hero.imageAlt}
  />

  <FeaturesGeneral
    title={copy.featuresGeneral.title}
    subTitle={copy.featuresGeneral.subTitle}
    src={featureImage}
    alt={copy.featuresGeneral.imageAlt}
    features={t.data.features}
  />

  <FeaturesNavs
    title={copy.featuresNavs.title}
    tabs={[
      {
        ...copy.featuresNavs.tabs.tools,
        svg: 'tools',
        src: tools,
        first: true,
      },
      {
        ...copy.featuresNavs.tabs.dashboard,
        svg: 'dashboard',
        src: dashboard,
        second: true,
      },
      {
        ...copy.featuresNavs.tabs.features,
        svg: 'house',
        src: construction,
      },
    ]}
  />

  {/* KUNDA 49-Tool Ecosystem Showcase */}
  <section class="mx-auto max-w-[85rem] px-4 py-10 sm:px-6 lg:px-8 lg:py-14 2xl:max-w-full">
    <div class="mb-10 flex flex-col justify-between gap-4 sm:flex-row sm:items-end">
      <div>
        <span class="inline-flex items-center gap-1.5 rounded-full bg-orange-100 px-3 py-1 text-xs font-semibold text-orange-800 dark:bg-orange-950 dark:text-orange-300 mb-2">
          <span class="h-1.5 w-1.5 rounded-full bg-orange-500 animate-pulse"></span>
          Privacy-First Utilities
        </span>
        <h2 class="text-2xl font-bold tracking-tight text-neutral-800 sm:text-3xl lg:text-4xl dark:text-neutral-200">
          Essential In-Browser Tools
        </h2>
        <p class="mt-2 text-sm text-neutral-600 sm:text-base dark:text-neutral-400 max-w-xl">
          Deterministic developer, business, and document utilities processed directly inside your browser. No telemetry or server uploads.
        </p>
      </div>

      <PrimaryCTA
        title="Explore All 49 Tools"
        url={localePath(locale, '/tools')}
      />
    </div>

    {/* 6 Category Highlights */}
    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3 mb-10">
      {CATEGORIES.map(category => (
        <ToolCategoryCard category={category} />
      ))}
    </div>

    {/* Featured Tools Grid */}
    <div class="border-t border-neutral-200 pt-8 dark:border-neutral-800">
      <div class="mb-4 flex items-center justify-between">
        <h3 class="text-sm font-bold uppercase tracking-wider text-neutral-500">Popular Utilities</h3>
        <span class="text-xs text-emerald-600 dark:text-emerald-400 font-semibold">100% In-Browser Privacy</span>
      </div>
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {featuredTools().slice(0, 4).map(tool => (
          <ToolCard tool={tool} />
        ))}
      </div>
    </div>
  </section>

  <PricingSection pricing={t.data.pricing} />

  <FAQ title={copy.faqTitle} faqs={t.data.faqs} />

  <HeroSectionAlt
    title={copy.heroAlt.title}
    subTitle={copy.heroAlt.subTitle}
    url="https://github.com/kunda-works"
  />
</MainLayout>
