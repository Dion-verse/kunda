---
import MainLayout from '@/layouts/MainLayout.astro';
import PrimaryCTA from '@components/ui/buttons/PrimaryCTA.astro';
import SecondaryCTA from '@components/ui/buttons/SecondaryCTA.astro';
import FeaturesStatsAlt from '@components/sections/features/FeaturesStatsAlt.astro';
import TestimonialsSectionAlt from '@components/sections/testimonials/TestimonialsSectionAlt.astro';
import { getCopy } from '@/copy';
import type { MarketingLocale } from '@utils/locale';

/** The products index in one locale. */
interface Props {
  locale: MarketingLocale;
}

const { locale } = Astro.props;
const copy = getCopy(locale).productsIndex;

const avatarSrcs = [
  'https://images.unsplash.com/photo-1500648767791-00dcc994a43e?q=80&w=1374&auto=format&fit=crop&ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=facearea&facepad=2&w=320&h=320&q=80',
  'https://images.unsplash.com/photo-1544005313-94ddf0286df2?q=80&w=1376&auto=format&fit=crop&ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D8&auto=format&fit=facearea&facepad=2&w=320&h=320&q=80',
  'https://images.unsplash.com/photo-1474176857210-7287d38d27c6?q=80&w=1470&auto=format&fit=crop&ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D8&auto=format&fit=facearea&facepad=2&w=320&h=320&q=80',
];

const testimonials = copy.testimonials.quotes.map((quote, index) => ({
  ...quote,
  avatarSrc: avatarSrcs[index],
}));
---

<MainLayout
  title={copy.title}
  description={copy.metaDescription}
  ogTitle={copy.ogTitle}
>
  <div class="mx-auto max-w-[85rem] px-4 py-10 sm:px-6 lg:px-8 lg:py-14 2xl:max-w-full">
    <div class="mb-4 flex items-center justify-between gap-8 sm:mb-8 md:mb-12">
      <div class="flex items-center gap-12">
        <h1 class="text-2xl font-bold tracking-tight text-balance text-neutral-800 md:text-4xl md:leading-tight dark:text-neutral-200">
          {copy.heading}
        </h1>
        {copy.subTitle && (
          <p class="hidden max-w-(--breakpoint-sm) text-pretty text-neutral-600 md:block dark:text-neutral-400">
            {copy.subTitle}
          </p>
        )}
      </div>
      <PrimaryCTA
        title="Explore Free Tools"
        url="/tools"
        noArrow={true}
      />
    </div>

    {/* Incubator / In Development Announcement Card (matching Micro-SaaS clean state) */}
    <div class="relative overflow-hidden rounded-xl border border-neutral-200 bg-white p-8 text-center shadow-lg md:p-14 dark:border-neutral-700/60 dark:bg-neutral-800/80">
      <div class="mx-auto max-w-2xl">
        <span class="inline-flex items-center gap-2 rounded-full bg-orange-100 px-3.5 py-1 text-xs font-semibold text-orange-800 dark:bg-orange-950 dark:text-orange-300">
          <span class="inline-block h-2 w-2 rounded-full bg-orange-500 animate-pulse"></span>
          KUNDA Software Lab & Ecosystem
        </span>
        <h2 class="mt-5 text-2xl font-bold tracking-tight text-neutral-800 md:text-3xl dark:text-neutral-100">
          {locale === 'fr' ? 'Produits logiciels en cours de développement' : 'Software Products in Active Development'}
        </h2>
        <p class="mt-3 text-pretty text-base text-neutral-600 leading-relaxed dark:text-neutral-400">
          {locale === 'fr' 
            ? 'Nous concevons des applications logicielles ciblées et performantes pour éliminer les goulots d’étranglement opérationnels. De nouveaux produits seront déployés ici progressivement.'
            : 'We are engineering single-purpose, high-impact software applications designed to eliminate specific business bottlenecks without enterprise bloat. Commercial products will be released here progressively.'}
        </p>
        <div class="mt-8 flex flex-wrap items-center justify-center gap-4">
          <PrimaryCTA
            title={locale === 'fr' ? 'Demander un produit sur mesure' : 'Request a Custom Product'}
            url={locale === 'fr' ? '/fr/contact' : '/contact'}
          />
          <SecondaryCTA
            title={locale === 'fr' ? 'Parcourir les outils gratuits' : 'Browse Free Online Tools'}
            url={locale === 'fr' ? '/fr/tools' : '/tools'}
          />
        </div>
      </div>
    </div>
  </div>
  {/* Features statistics section */}
  <FeaturesStatsAlt
    title={copy.stats.title}
    subTitle={copy.stats.subTitle}
    benefits={copy.stats.benefits}
  />
  {/* Testimonials section */}
  <TestimonialsSectionAlt
    title={copy.testimonials.title}
    testimonials={testimonials}
  />
</MainLayout>
