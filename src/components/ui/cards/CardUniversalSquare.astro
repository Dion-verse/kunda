---
/**
 * CardUniversalSquare.astro
 *
 * Universal 1:1 Aspect Ratio Square Card Component.
 * Used across /tools and /resources for a uniform, premium application launcher grid.
 * Enforces:
 * - aspect-ratio: 1 / 1
 * - Deep charcoal backgrounds
 * - Subtle borders and soft gradients
 * - Strict SVG visual assets in the center preview
 * - Polished hover physics and micro-interactions
 */

interface Props {
  href: string;
  category: string;
  title: string;
  description: string;
  actionText?: string;
  statusText?: string;
  statusColor?: 'emerald' | 'orange' | 'violet' | 'blue';
  metaText?: string;
  isDownload?: boolean;
}

const {
  href,
  category,
  title,
  description,
  actionText = 'Launch Tool',
  statusText = 'Active',
  statusColor = 'emerald',
  metaText = 'Free & Unlimited',
  isDownload = false,
} = Astro.props;

const dotColors = {
  emerald: 'bg-emerald-500',
  orange: 'bg-orange-500',
  violet: 'bg-violet-500',
  blue: 'bg-blue-500',
};
---

<a
  href={href}
  download={isDownload ? true : undefined}
  class="group relative flex flex-col justify-between aspect-square rounded-2xl border border-neutral-200/80 bg-white p-5 sm:p-6 shadow-md transition-all duration-300 hover:-translate-y-1.5 hover:border-orange-500/50 hover:shadow-2xl dark:border-neutral-800 dark:bg-[#18181b] overflow-hidden"
>
  {/* Subtle gradient depth */}
  <div class="pointer-events-none absolute inset-0 bg-gradient-to-b from-neutral-50/60 via-transparent to-transparent opacity-80 dark:from-neutral-800/20 dark:to-transparent"></div>

  {/* 1. TOP ROW: Category Label (Top-Left) & Status Indicator / Glyph (Top-Right) */}
  <div class="relative z-10 flex items-center justify-between">
    <span class="text-[11px] font-bold tracking-widest text-neutral-400 uppercase dark:text-neutral-500 font-mono">
      {category}
    </span>

    <div class="flex items-center gap-2">
      <span class="inline-flex items-center gap-1.5 rounded-full bg-neutral-100 px-2.5 py-0.5 text-[10px] font-medium text-neutral-600 dark:bg-neutral-800 dark:text-neutral-400">
        <span class:list={['h-1.5 w-1.5 rounded-full', dotColors[statusColor]]}></span>
        {statusText}
      </span>

      <div class="flex h-7 w-7 items-center justify-center rounded-lg bg-neutral-100 text-neutral-700 dark:bg-neutral-800 dark:text-neutral-300">
        <slot name="icon">
          {/* Default SVG fallback icon */}
          <svg class="h-3.5 w-3.5 text-neutral-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="12" cy="12" r="10"></circle>
            <line x1="12" y1="8" x2="12" y2="12"></line>
            <line x1="12" y1="16" x2="12.01" y2="16"></line>
          </svg>
        </slot>
      </div>
    </div>
  </div>

  {/* 2. CENTER: Large, Visually Attractive SVG Illustration Preview */}
  <div class="relative z-10 my-auto flex-1 w-full overflow-hidden rounded-xl bg-neutral-950 border border-neutral-200/70 dark:border-neutral-800/90 p-2 sm:p-3 flex items-center justify-center my-3 shadow-inner">
    <div class="h-full w-full flex items-center justify-center transition-transform duration-500 ease-out group-hover:scale-105">
      <slot name="illustration" />
    </div>
  </div>

  {/* 3. BOTTOM: Tool/Resource Title & Description */}
  <div class="relative z-10">
    <h2 class="text-base sm:text-lg font-bold tracking-tight text-neutral-900 group-hover:text-orange-600 dark:text-neutral-100 dark:group-hover:text-orange-400 transition-colors line-clamp-1">
      {title}
    </h2>
    <p class="mt-1 text-xs text-neutral-600 dark:text-neutral-400 line-clamp-2 leading-relaxed">
      {description}
    </p>

    {/* 4. BOTTOM ACTION: Minimal Action Link with Animated Arrow */}
    <div class="mt-3 flex items-center justify-between border-t border-neutral-100 pt-2.5 dark:border-neutral-800/80">
      <span class="text-[11px] text-neutral-400 dark:text-neutral-500 font-mono">
        {metaText}
      </span>
      <span class="inline-flex items-center gap-1 text-xs font-semibold text-orange-600 dark:text-orange-400 group-hover:translate-x-1 transition-transform">
        {actionText}
        {isDownload ? (
          <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
          </svg>
        ) : (
          <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
            <path d="M5 12h14m-7-7l7 7-7 7"></path>
          </svg>
        )}
      </span>
    </div>
  </div>
</a>
