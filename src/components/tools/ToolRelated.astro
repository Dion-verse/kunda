---
import type { Tool } from '@/data/tools';
import { TOOLS } from '@/data/tools';
import ToolCard from './ToolCard.astro';

interface Props {
  currentTool: Tool;
}

const { currentTool } = Astro.props;

// Pick related tools by slugs if defined, otherwise grab tools from same category
let related: Tool[] = [];
if (currentTool.relatedTools && currentTool.relatedTools.length > 0) {
  related = TOOLS.filter(t => currentTool.relatedTools?.includes(t.slug));
}
if (related.length < 3) {
  const sameCat = TOOLS.filter(
    t => t.category === currentTool.category && t.slug !== currentTool.slug
  );
  related = [...related, ...sameCat].slice(0, 3);
}
---

{related.length > 0 && (
  <section class="mt-16 border-t border-neutral-200 pt-12 dark:border-neutral-700/60">
    <div class="mb-6 flex items-center justify-between">
      <div>
        <h2 class="text-xl font-bold text-neutral-800 dark:text-neutral-100">
          Related Tools
        </h2>
        <p class="text-sm text-neutral-600 dark:text-neutral-400">
          Explore complementary utilities in the KUNDA ecosystem.
        </p>
      </div>
      <a
        href={`/tools/${currentTool.category}`}
        class="text-xs font-semibold text-orange-500 hover:text-orange-600 dark:text-orange-400"
      >
        View all in category â†’
      </a>
    </div>

    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {related.map(tool => (
        <ToolCard tool={tool} />
      ))}
    </div>
  </section>
)}

