---
---

<div class="relative mx-auto w-full max-w-2xl">
  <div class="relative flex items-center">
    <div class="pointer-events-none absolute inset-y-0 start-0 flex items-center ps-4 text-neutral-400">
      <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
      </svg>
    </div>

    <input
      type="search"
      id="tool-search-input"
      placeholder="Search 49+ tools... (e.g. merge pdf, resize image, word count, invoice, percentage)"
      class="block w-full rounded-2xl border border-neutral-300 bg-white py-3.5 pe-20 ps-12 text-sm text-neutral-800 placeholder-neutral-400 shadow-sm transition focus:border-orange-500 focus:outline-hidden focus:ring-2 focus:ring-orange-500/20 sm:text-base dark:border-neutral-700 dark:bg-neutral-800 dark:text-neutral-100 dark:placeholder-neutral-500"
      autocomplete="off"
    />

    <div class="absolute inset-y-0 end-0 flex items-center pe-3 gap-1.5">
      <button
        id="tool-search-clear"
        type="button"
        class="hidden rounded-lg p-1 text-neutral-400 hover:text-neutral-600 dark:hover:text-neutral-200"
        aria-label="Clear search"
      >
        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
      <kbd class="hidden rounded-md border border-neutral-300 bg-neutral-100 px-1.5 py-0.5 text-[11px] font-semibold text-neutral-500 sm:inline-block dark:border-neutral-700 dark:bg-neutral-700 dark:text-neutral-400">
        /
      </kbd>
    </div>
  </div>

  <div id="tool-search-meta" class="mt-2 flex items-center justify-between px-1 text-xs text-neutral-500 dark:text-neutral-400">
    <span id="tool-results-count">Showing all tools</span>
    <span class="inline-flex items-center gap-1 text-emerald-600 dark:text-emerald-400 font-medium">
      <span class="inline-block h-1.5 w-1.5 rounded-full bg-emerald-500"></span>
      100% In-Browser Privacy
    </span>
  </div>
</div>

