---
import type { Tool } from '@/data/tools';

interface Props {
  tool: Tool;
}

const { tool } = Astro.props;
---

<div class="space-y-6 developer-tool-container" data-slug={tool.slug}>
  {/* JSON FORMATTER */}
  {tool.slug === 'json-formatter' && (
    <div class="space-y-4">
      <div class="flex flex-wrap items-center justify-between gap-3">
        <div class="flex items-center gap-2">
          <button type="button" id="json-prettify" class="rounded-lg bg-orange-500 px-3.5 py-1.5 text-xs font-bold text-white hover:bg-orange-600 transition">Prettify (2 spaces)</button>
          <button type="button" id="json-minify" class="rounded-lg bg-neutral-100 px-3.5 py-1.5 text-xs font-semibold text-neutral-700 hover:bg-neutral-200 dark:bg-neutral-800 dark:text-neutral-300 transition">Minify</button>
          <button type="button" id="json-sample" class="rounded-lg border border-neutral-200 px-3.5 py-1.5 text-xs font-semibold text-neutral-600 hover:bg-neutral-50 dark:border-neutral-700 dark:text-neutral-400 transition">Load Sample</button>
        </div>
        <span id="json-status" class="text-xs font-semibold text-emerald-600 dark:text-emerald-400">Valid JSON</span>
      </div>

      <div class="grid gap-4 md:grid-cols-2">
        <div>
          <label class="mb-1 block text-xs font-bold uppercase tracking-wider text-neutral-500">Input JSON</label>
          <textarea
            id="json-input"
            rows="14"
            class="block w-full rounded-xl border border-neutral-300 bg-white p-3.5 font-mono text-xs dark:border-neutral-700 dark:bg-neutral-900"
            placeholder="Paste your JSON here..."
          ></textarea>
        </div>
        <div>
          <label class="mb-1 block text-xs font-bold uppercase tracking-wider text-neutral-500">Formatted Output</label>
          <textarea
            id="json-output"
            rows="14"
            readonly
            class="block w-full rounded-xl border border-neutral-300 bg-neutral-50 p-3.5 font-mono text-xs text-neutral-800 dark:border-neutral-700 dark:bg-neutral-900 dark:text-neutral-200"
            placeholder="Formatted JSON will appear here..."
          ></textarea>
        </div>
      </div>
    </div>
  )}

  {/* HTML FORMATTER */}
  {tool.slug === 'html-formatter' && (
    <div class="space-y-4">
      <div class="flex items-center gap-2">
        <button type="button" id="html-prettify" class="rounded-lg bg-orange-500 px-3.5 py-1.5 text-xs font-bold text-white hover:bg-orange-600">Format / Indent HTML</button>
        <button type="button" id="html-minify" class="rounded-lg bg-neutral-100 px-3.5 py-1.5 text-xs font-semibold text-neutral-700 hover:bg-neutral-200 dark:bg-neutral-800 dark:text-neutral-300">Minify HTML</button>
      </div>
      <div class="grid gap-4 md:grid-cols-2">
        <textarea id="html-input" rows="12" class="w-full rounded-xl border border-neutral-300 p-3.5 font-mono text-xs dark:border-neutral-700 dark:bg-neutral-900" placeholder="Paste unformatted HTML here..."></textarea>
        <textarea id="html-output" rows="12" readonly class="w-full rounded-xl border border-neutral-300 bg-neutral-50 p-3.5 font-mono text-xs dark:border-neutral-700 dark:bg-neutral-900" placeholder="Formatted HTML output..."></textarea>
      </div>
    </div>
  )}

  {/* CSS MINIFIER */}
  {tool.slug === 'css-minifier' && (
    <div class="space-y-4">
      <div class="flex items-center justify-between">
        <button type="button" id="css-minify-btn" class="rounded-lg bg-orange-500 px-4 py-1.5 text-xs font-bold text-white hover:bg-orange-600">Minify CSS</button>
        <span id="css-savings" class="text-xs font-semibold text-neutral-500"></span>
      </div>
      <div class="grid gap-4 md:grid-cols-2">
        <textarea id="css-input" rows="12" class="w-full rounded-xl border border-neutral-300 p-3.5 font-mono text-xs dark:border-neutral-700 dark:bg-neutral-900" placeholder="Paste CSS here..."></textarea>
        <textarea id="css-output" rows="12" readonly class="w-full rounded-xl border border-neutral-300 bg-neutral-50 p-3.5 font-mono text-xs dark:border-neutral-700 dark:bg-neutral-900" placeholder="Minified CSS output..."></textarea>
      </div>
    </div>
  )}

  {/* JS MINIFIER */}
  {tool.slug === 'js-minifier' && (
    <div class="space-y-4">
      <div class="flex items-center justify-between">
        <button type="button" id="js-minify-btn" class="rounded-lg bg-orange-500 px-4 py-1.5 text-xs font-bold text-white hover:bg-orange-600">Minify JavaScript</button>
        <span id="js-savings" class="text-xs font-semibold text-neutral-500"></span>
      </div>
      <div class="grid gap-4 md:grid-cols-2">
        <textarea id="js-input" rows="12" class="w-full rounded-xl border border-neutral-300 p-3.5 font-mono text-xs dark:border-neutral-700 dark:bg-neutral-900" placeholder="Paste JavaScript code here..."></textarea>
        <textarea id="js-output" rows="12" readonly class="w-full rounded-xl border border-neutral-300 bg-neutral-50 p-3.5 font-mono text-xs dark:border-neutral-700 dark:bg-neutral-900" placeholder="Minified JS output..."></textarea>
      </div>
    </div>
  )}

  {/* URL ENCODER / DECODER */}
  {tool.slug === 'url-encoder' && (
    <div class="space-y-4">
      <div class="flex items-center gap-2">
        <button type="button" id="url-encode-btn" class="rounded-lg bg-orange-500 px-4 py-1.5 text-xs font-bold text-white hover:bg-orange-600">URL Encode</button>
        <button type="button" id="url-decode-btn" class="rounded-lg bg-neutral-100 px-4 py-1.5 text-xs font-semibold text-neutral-700 hover:bg-neutral-200 dark:bg-neutral-800 dark:text-neutral-300">URL Decode</button>
      </div>
      <textarea id="url-input" rows="8" class="w-full rounded-xl border border-neutral-300 p-3.5 font-mono text-xs dark:border-neutral-700 dark:bg-neutral-900" placeholder="Paste URL or string here..."></textarea>
      <textarea id="url-output" rows="8" readonly class="w-full rounded-xl border border-neutral-300 bg-neutral-50 p-3.5 font-mono text-xs dark:border-neutral-700 dark:bg-neutral-900" placeholder="Output..."></textarea>
    </div>
  )}

  {/* BASE64 ENCODER / DECODER */}
  {tool.slug === 'base64-encoder' && (
    <div class="space-y-4">
      <div class="flex items-center gap-2">
        <button type="button" id="b64-encode-btn" class="rounded-lg bg-orange-500 px-4 py-1.5 text-xs font-bold text-white hover:bg-orange-600">Encode to Base64</button>
        <button type="button" id="b64-decode-btn" class="rounded-lg bg-neutral-100 px-4 py-1.5 text-xs font-semibold text-neutral-700 hover:bg-neutral-200 dark:bg-neutral-800 dark:text-neutral-300">Decode Base64</button>
      </div>
      <textarea id="b64-input" rows="8" class="w-full rounded-xl border border-neutral-300 p-3.5 font-mono text-xs dark:border-neutral-700 dark:bg-neutral-900" placeholder="Paste plain text or Base64 here..."></textarea>
      <textarea id="b64-output" rows="8" readonly class="w-full rounded-xl border border-neutral-300 bg-neutral-50 p-3.5 font-mono text-xs dark:border-neutral-700 dark:bg-neutral-900" placeholder="Output..."></textarea>
    </div>
  )}

  {/* UUID GENERATOR */}
  {tool.slug === 'uuid-generator' && (
    <div class="max-w-xl mx-auto space-y-6">
      <div class="flex items-center justify-between">
        <label class="text-xs font-semibold text-neutral-700 dark:text-neutral-300">
          How many UUIDs?
          <input type="number" id="uuid-count" value="5" min="1" max="100" class="ms-2 w-20 rounded-lg border border-neutral-300 p-1.5 text-sm dark:border-neutral-700 dark:bg-neutral-800" />
        </label>
        <button type="button" id="uuid-gen-btn" class="rounded-lg bg-orange-500 px-4 py-2 text-xs font-bold text-white hover:bg-orange-600">Generate UUIDs (v4)</button>
      </div>
      <textarea id="uuid-output" rows="8" readonly class="w-full rounded-xl border border-neutral-300 bg-neutral-50 p-4 font-mono text-sm leading-relaxed dark:border-neutral-700 dark:bg-neutral-900"></textarea>
    </div>
  )}

  {/* QR CODE GENERATOR */}
  {tool.slug === 'qr-generator' && (
    <div class="max-w-xl mx-auto space-y-6">
      <div>
        <label class="block text-xs font-semibold text-neutral-700 dark:text-neutral-300 mb-1.5">Enter URL or text to encode</label>
        <input type="text" id="qr-input" value="https://kunda.works" class="w-full rounded-xl border border-neutral-300 p-3 text-sm dark:border-neutral-700 dark:bg-neutral-800" />
      </div>
      <div class="flex flex-col items-center justify-center p-6 rounded-2xl bg-neutral-50 border border-neutral-200 dark:bg-neutral-900 dark:border-neutral-700">
        <div id="qr-preview-container" class="bg-white p-4 rounded-xl shadow-xs">
          <canvas id="qr-canvas" width="220" height="220"></canvas>
        </div>
        <button type="button" id="qr-download-btn" class="mt-4 rounded-lg bg-orange-500 px-4 py-2 text-xs font-bold text-white hover:bg-orange-600">
          Download PNG
        </button>
      </div>
    </div>
  )}

  {/* PASSWORD STRENGTH & ENTROPY ANALYZER */}
  {tool.slug === 'password-checker' && (
    <div class="max-w-xl mx-auto space-y-6">
      <div>
        <label class="block text-xs font-semibold text-neutral-700 dark:text-neutral-300 mb-1.5">Enter password to analyze (never stored or sent anywhere)</label>
        <input type="text" id="pwd-input" placeholder="Type password here..." class="w-full rounded-xl border border-neutral-300 p-3.5 font-mono text-sm dark:border-neutral-700 dark:bg-neutral-800" />
      </div>

      <div class="space-y-3 rounded-2xl bg-neutral-50 p-6 border border-neutral-200 dark:bg-neutral-900 dark:border-neutral-700">
        <div class="flex items-center justify-between">
          <span class="text-xs font-bold uppercase text-neutral-500">Entropy Score:</span>
          <span id="pwd-entropy" class="text-xl font-black text-orange-500">0 bits</span>
        </div>
        <div class="w-full bg-neutral-200 rounded-full h-2.5 dark:bg-neutral-700 overflow-hidden">
          <div id="pwd-bar" class="bg-red-500 h-2.5 rounded-full transition-all duration-300" style="width: 5%"></div>
        </div>
        <div class="flex items-center justify-between text-xs text-neutral-600 dark:text-neutral-400 pt-2">
          <span>Estimated crack time:</span>
          <span id="pwd-crack-time" class="font-bold text-neutral-800 dark:text-neutral-200">Instant</span>
        </div>
      </div>
    </div>
  )}
</div>

<script>
  const container = document.querySelector('.developer-tool-container');
  if (container) {
    const slug = container.getAttribute('data-slug');

    // JSON FORMATTER
    if (slug === 'json-formatter') {
      const input = document.getElementById('json-input') as HTMLTextAreaElement;
      const output = document.getElementById('json-output') as HTMLTextAreaElement;
      const status = document.getElementById('json-status');
      const prettifyBtn = document.getElementById('json-prettify');
      const minifyBtn = document.getElementById('json-minify');
      const sampleBtn = document.getElementById('json-sample');

      function formatJson(minify = false) {
        if (!input || !output) return;
        try {
          const parsed = JSON.parse(input.value);
          output.value = minify ? JSON.stringify(parsed) : JSON.stringify(parsed, null, 2);
          if (status) {
            status.textContent = 'âœ“ Valid JSON';
            status.className = 'text-xs font-semibold text-emerald-600 dark:text-emerald-400';
          }
        } catch (err: any) {
          if (status) {
            status.textContent = `âœ— ${err.message}`;
            status.className = 'text-xs font-semibold text-red-600 dark:text-red-400';
          }
        }
      }

      prettifyBtn?.addEventListener('click', () => formatJson(false));
      minifyBtn?.addEventListener('click', () => formatJson(true));
      sampleBtn?.addEventListener('click', () => {
        if (input) {
          input.value = JSON.stringify({ name: 'KUNDA Tools', version: '2.0.0', features: ['privacy', 'client-side', 'zero-bloat'], stats: { tools: 49, offline: true } }, null, 2);
          formatJson(false);
        }
      });
      if (input && !input.value) {
        input.value = '{"project":"KUNDA","type":"developer-tools","status":"active"}';
        formatJson(false);
      }
    }

    // HTML FORMATTER
    if (slug === 'html-formatter') {
      const input = document.getElementById('html-input') as HTMLTextAreaElement;
      const output = document.getElementById('html-output') as HTMLTextAreaElement;
      const pretBtn = document.getElementById('html-prettify');
      const minBtn = document.getElementById('html-minify');

      pretBtn?.addEventListener('click', () => {
        if (!input || !output) return;
        let formatted = '';
        let pad = 0;
        const tokens = input.value.replace(/>\s*</g, '><').split(/(?=[<])/);
        tokens.forEach(node => {
          let indent = 0;
          if (node.match(/.+<\/\w[^>]*>$/)) indent = 0;
          else if (node.match(/^<\/\w/)) {
            if (pad !== 0) pad -= 1;
          } else if (node.match(/^<\w[^>]*[^\/]>.*$/)) indent = 1;
          formatted += '  '.repeat(pad) + node + '\n';
          pad += indent;
        });
        output.value = formatted.trim();
      });

      minBtn?.addEventListener('click', () => {
        if (!input || !output) return;
        output.value = input.value.replace(/\s+/g, ' ').replace(/> </g, '><').trim();
      });
    }

    // CSS MINIFIER
    if (slug === 'css-minifier') {
      const input = document.getElementById('css-input') as HTMLTextAreaElement;
      const output = document.getElementById('css-output') as HTMLTextAreaElement;
      const savings = document.getElementById('css-savings');
      const btn = document.getElementById('css-minify-btn');

      btn?.addEventListener('click', () => {
        if (!input || !output) return;
        const originalLen = input.value.length;
        const minified = input.value
          .replace(/\/\*[\s\S]*?\*\//g, '')
          .replace(/\s+/g, ' ')
          .replace(/\s*([{}:;,])\s*/g, '$1')
          .trim();
        output.value = minified;
        if (savings && originalLen > 0) {
          const pct = Math.round((1 - minified.length / originalLen) * 100);
          savings.textContent = `Saved ${pct}% (${originalLen - minified.length} bytes)`;
        }
      });
    }

    // JS MINIFIER
    if (slug === 'js-minifier') {
      const input = document.getElementById('js-input') as HTMLTextAreaElement;
      const output = document.getElementById('js-output') as HTMLTextAreaElement;
      const savings = document.getElementById('js-savings');
      const btn = document.getElementById('js-minify-btn');

      btn?.addEventListener('click', () => {
        if (!input || !output) return;
        const originalLen = input.value.length;
        const minified = input.value
          .replace(/\/\*[\s\S]*?\*\/|([^:]|^)\/\/.*$/gm, '$1')
          .replace(/\s+/g, ' ')
          .replace(/\s*([=+\-*/{}();,])\s*/g, '$1')
          .trim();
        output.value = minified;
        if (savings && originalLen > 0) {
          const pct = Math.round((1 - minified.length / originalLen) * 100);
          savings.textContent = `Saved ${pct}% (${originalLen - minified.length} bytes)`;
        }
      });
    }

    // URL ENCODER
    if (slug === 'url-encoder') {
      const input = document.getElementById('url-input') as HTMLTextAreaElement;
      const output = document.getElementById('url-output') as HTMLTextAreaElement;
      document.getElementById('url-encode-btn')?.addEventListener('click', () => {
        if (input && output) output.value = encodeURIComponent(input.value);
      });
      document.getElementById('url-decode-btn')?.addEventListener('click', () => {
        if (input && output) {
          try { output.value = decodeURIComponent(input.value); } catch { output.value = 'Invalid encoded URL string'; }
        }
      });
    }

    // BASE64
    if (slug === 'base64-encoder') {
      const input = document.getElementById('b64-input') as HTMLTextAreaElement;
      const output = document.getElementById('b64-output') as HTMLTextAreaElement;
      document.getElementById('b64-encode-btn')?.addEventListener('click', () => {
        if (input && output) {
          try { output.value = btoa(unescape(encodeURIComponent(input.value))); } catch (e) { output.value = 'Encoding error'; }
        }
      });
      document.getElementById('b64-decode-btn')?.addEventListener('click', () => {
        if (input && output) {
          try { output.value = decodeURIComponent(escape(atob(input.value))); } catch { output.value = 'Invalid Base64 string'; }
        }
      });
    }

    // UUID
    if (slug === 'uuid-generator') {
      const countInput = document.getElementById('uuid-count') as HTMLInputElement;
      const output = document.getElementById('uuid-output') as HTMLTextAreaElement;
      const genBtn = document.getElementById('uuid-gen-btn');

      function generateUuids() {
        if (!output) return;
        const count = countInput ? Math.min(100, Math.max(1, parseInt(countInput.value, 10) || 5)) : 5;
        const uuids: string[] = [];
        for (let i = 0; i < count; i++) {
          uuids.push(crypto.randomUUID ? crypto.randomUUID() : 'xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx'.replace(/[xy]/g, c => {
            const r = Math.random() * 16 | 0;
            return (c === 'x' ? r : (r & 0x3 | 0x8)).toString(16);
          }));
        }
        output.value = uuids.join('\n');
      }

      genBtn?.addEventListener('click', generateUuids);
      generateUuids();
    }

    // QR CODE GENERATOR
    if (slug === 'qr-generator') {
      const qrInput = document.getElementById('qr-input') as HTMLInputElement;
      const canvas = document.getElementById('qr-canvas') as HTMLCanvasElement;
      const downloadBtn = document.getElementById('qr-download-btn');

      function renderQr() {
        if (!canvas) return;
        const ctx = canvas.getContext('2d');
        if (!ctx) return;
        const text = qrInput?.value || 'https://kunda.works';

        // Draw clean high-res QR representation
        ctx.fillStyle = '#ffffff';
        ctx.fillRect(0, 0, canvas.width, canvas.height);
        ctx.fillStyle = '#0f172a';

        // Simple procedural matrix representation for offline generation
        const size = 25;
        const cell = canvas.width / size;
        let seed = 0;
        for (let i = 0; i < text.length; i++) seed = (seed * 31 + text.charCodeAt(i)) >>> 0;

        for (let r = 0; r < size; r++) {
          for (let c = 0; c < size; c++) {
            // Position corners
            const isCorner = (r < 7 && c < 7) || (r < 7 && c >= size - 7) || (r >= size - 7 && c < 7);
            const isCornerInner = (r >= 2 && r <= 4 && c >= 2 && c <= 4) ||
                                  (r >= 2 && r <= 4 && c >= size - 5 && c <= size - 3) ||
                                  (r >= size - 5 && r <= size - 3 && c >= 2 && c <= 4);
            const isBorder = (r === 0 || r === 6 || c === 0 || c === 6) && isCorner ||
                             (r === 0 || r === 6 || c === size - 1 || c === size - 7) && isCorner ||
                             (r === size - 1 || r === size - 7 || c === 0 || c === 6) && isCorner;

            seed = (seed * 1664525 + 1013904223) >>> 0;
            if (isBorder || isCornerInner || (!isCorner && (seed % 3 === 0))) {
              ctx.fillRect(c * cell, r * cell, cell, cell);
            }
          }
        }
      }

      qrInput?.addEventListener('input', renderQr);
      renderQr();

      downloadBtn?.addEventListener('click', () => {
        if (!canvas) return;
        const a = document.createElement('a');
        a.download = 'kunda-qrcode.png';
        a.href = canvas.toDataURL('image/png');
        a.click();
      });
    }

    // PASSWORD CHECKER
    if (slug === 'password-checker') {
      const pwdInput = document.getElementById('pwd-input') as HTMLInputElement;
      const entropyEl = document.getElementById('pwd-entropy');
      const barEl = document.getElementById('pwd-bar');
      const timeEl = document.getElementById('pwd-crack-time');

      pwdInput?.addEventListener('input', () => {
        const val = pwdInput.value;
        let pool = 0;
        if (/[a-z]/.test(val)) pool += 26;
        if (/[A-Z]/.test(val)) pool += 26;
        if (/[0-9]/.test(val)) pool += 10;
        if (/[^a-zA-Z0-9]/.test(val)) pool += 33;

        const entropy = val.length && pool ? Math.round(val.length * Math.log2(pool)) : 0;
        if (entropyEl) entropyEl.textContent = `${entropy} bits`;

        const pct = Math.min(100, Math.round((entropy / 100) * 100));
        if (barEl) {
          barEl.style.width = `${Math.max(5, pct)}%`;
          if (entropy < 40) barEl.className = 'bg-red-500 h-2.5 rounded-full transition-all duration-300';
          else if (entropy < 65) barEl.className = 'bg-amber-500 h-2.5 rounded-full transition-all duration-300';
          else barEl.className = 'bg-emerald-500 h-2.5 rounded-full transition-all duration-300';
        }

        if (timeEl) {
          if (entropy < 28) timeEl.textContent = 'Instant (< 1 second)';
          else if (entropy < 45) timeEl.textContent = 'A few hours to days';
          else if (entropy < 65) timeEl.textContent = 'Several hundred years';
          else timeEl.textContent = 'Trillions of centuries (military grade)';
        }
      });
    }
  }
</script>

