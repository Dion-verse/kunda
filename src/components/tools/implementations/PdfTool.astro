---
import type { Tool } from '@/data/tools';

interface Props {
  tool: Tool;
}

const { tool } = Astro.props;
---

<div class="space-y-6 pdf-tool-container" data-slug={tool.slug}>
  {/* PDF Upload Dropzone */}
  <div
    id="pdf-dropzone"
    class="flex flex-col items-center justify-center rounded-2xl border-2 border-dashed border-neutral-300 bg-neutral-50/70 p-8 text-center transition hover:border-orange-500/70 hover:bg-neutral-50 dark:border-neutral-700 dark:bg-neutral-900/40 dark:hover:border-orange-500/70 cursor-pointer"
  >
    <div class="flex h-12 w-12 items-center justify-center rounded-2xl bg-red-100 text-red-600 dark:bg-red-950 dark:text-red-400 mb-3">
      <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21h10a2 2 0 002-2V9.414a1 1 0 00-.293-.707l-5.414-5.414A1 1 0 0012.586 3H7a2 2 0 00-2 2v14a2 2 0 002 2z" />
      </svg>
    </div>
    <p class="text-sm font-bold text-neutral-800 dark:text-neutral-200">
      {tool.slug === 'jpg-to-pdf' ? 'Click to select JPG images' : 'Click to select PDF document'}
    </p>
    <p class="mt-1 text-xs text-neutral-500">
      Files are parsed and processed 100% locally in your browser memory via pdf-lib WebAssembly.
    </p>
    <input
      type="file"
      id="pdf-file-input"
      accept={tool.slug === 'jpg-to-pdf' ? 'image/jpeg,image/jpg' : 'application/pdf'}
      multiple={tool.slug === 'merge-pdf' || tool.slug === 'jpg-to-pdf'}
      class="hidden"
    />
  </div>

  {/* Active PDF Workspace */}
  <div id="pdf-workspace" class="hidden space-y-6">
    <div class="rounded-xl border border-neutral-200/80 bg-white p-5 dark:border-neutral-700/60 dark:bg-neutral-800/60">
      <div id="pdf-files-summary" class="text-sm font-semibold text-neutral-800 dark:text-neutral-200 mb-4"></div>

      {tool.slug === 'rotate-pdf' && (
        <div class="flex items-center gap-3">
          <label class="text-xs font-bold uppercase text-neutral-500">Rotate Angle:</label>
          <select id="pdf-rotate-angle" class="rounded-lg border border-neutral-300 p-2 text-sm dark:border-neutral-700 dark:bg-neutral-800">
            <option value="90">90Â° Clockwise</option>
            <option value="180">180Â° Flip</option>
            <option value="270">270Â° Counter-Clockwise</option>
          </select>
        </div>
      )}

      {tool.slug === 'split-pdf' && (
        <div class="space-y-2">
          <label class="block text-xs font-bold uppercase text-neutral-500">Page Range to Extract (e.g. 1-3, 5)</label>
          <input type="text" id="pdf-split-range" value="1" placeholder="e.g. 1-2" class="w-full max-w-xs rounded-lg border border-neutral-300 p-2 text-sm dark:border-neutral-700 dark:bg-neutral-800" />
        </div>
      )}

      {tool.slug === 'unlock-pdf' && (
        <div class="space-y-3">
          <label class="block text-xs font-bold uppercase text-neutral-500">Enter Document Password</label>
          <input type="password" id="pdf-password-input" class="w-full max-w-xs rounded-lg border border-neutral-300 p-2 text-sm dark:border-neutral-700 dark:bg-neutral-800" />
          <p class="text-xs text-neutral-500">Only authorized document owners may remove passwords.</p>
        </div>
      )}

      {tool.slug === 'word-to-pdf' && (
        <div class="rounded-lg bg-blue-50 p-3.5 text-xs text-blue-800 dark:bg-blue-950/40 dark:text-blue-300">
          <p class="font-bold">Browser Print-to-PDF Disclosure:</p>
          <p class="mt-0.5">Modern browsers render Word/HTML documents natively. Click below to preview and export via your operating system's native PDF print rasterizer.</p>
        </div>
      )}
    </div>

    <div class="flex items-center justify-between border-t border-neutral-200 pt-4 dark:border-neutral-700">
      <span id="pdf-processing-status" class="text-xs font-semibold text-emerald-600 dark:text-emerald-400">Ready to execute</span>
      <button
        type="button"
        id="pdf-execute-btn"
        class="inline-flex items-center gap-2 rounded-xl bg-orange-500 px-6 py-2.5 text-sm font-bold text-white shadow-md shadow-orange-500/20 hover:bg-orange-600 transition"
      >
        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
        </svg>
        <span id="pdf-action-label">Process & Download</span>
      </button>
    </div>
  </div>
</div>

<script>
  import { PDFDocument, degrees } from 'pdf-lib';

  const container = document.querySelector('.pdf-tool-container');
  if (container) {
    const slug = container.getAttribute('data-slug');
    const dropzone = document.getElementById('pdf-dropzone');
    const fileInput = document.getElementById('pdf-file-input') as HTMLInputElement;
    const workspace = document.getElementById('pdf-workspace');
    const filesSummary = document.getElementById('pdf-files-summary');
    const executeBtn = document.getElementById('pdf-execute-btn');
    const statusText = document.getElementById('pdf-processing-status');

    let loadedFiles: File[] = [];

    dropzone?.addEventListener('click', () => fileInput?.click());
    dropzone?.addEventListener('dragover', e => {
      e.preventDefault();
      dropzone.classList.add('border-orange-500');
    });
    dropzone?.addEventListener('dragleave', () => dropzone.classList.remove('border-orange-500'));
    dropzone?.addEventListener('drop', e => {
      e.preventDefault();
      dropzone.classList.remove('border-orange-500');
      if (e.dataTransfer?.files.length) handleFiles(Array.from(e.dataTransfer.files));
    });

    fileInput?.addEventListener('change', () => {
      if (fileInput.files?.length) handleFiles(Array.from(fileInput.files));
    });

    function handleFiles(files: File[]) {
      loadedFiles = files;
      if (filesSummary) {
        filesSummary.textContent = `Selected ${files.length} file(s): ${files.map(f => f.name).join(', ')}`;
      }
      workspace?.classList.remove('hidden');
    }

    executeBtn?.addEventListener('click', async () => {
      if (loadedFiles.length === 0) return;
      if (statusText) statusText.textContent = 'Processing PDF in browser memory...';

      try {
        if (slug === 'merge-pdf') {
          const mergedDoc = await PDFDocument.create();
          for (const file of loadedFiles) {
            const bytes = await file.arrayBuffer();
            const doc = await PDFDocument.load(bytes);
            const copiedPages = await mergedDoc.copyPages(doc, doc.getPageIndices());
            copiedPages.forEach(p => mergedDoc.addPage(p));
          }
          const pdfBytes = await mergedDoc.save();
          downloadPdf(pdfBytes, 'merged-document.pdf');
        } else if (slug === 'rotate-pdf') {
          const angle = parseInt((document.getElementById('pdf-rotate-angle') as HTMLSelectElement)?.value || '90', 10);
          const bytes = await loadedFiles[0].arrayBuffer();
          const doc = await PDFDocument.load(bytes);
          const pages = doc.getPages();
          pages.forEach(p => p.setRotation(degrees(p.getRotation().angle + angle)));
          const pdfBytes = await doc.save();
          downloadPdf(pdfBytes, `rotated-${loadedFiles[0].name}`);
        } else if (slug === 'split-pdf') {
          const bytes = await loadedFiles[0].arrayBuffer();
          const doc = await PDFDocument.load(bytes);
          const splitDoc = await PDFDocument.create();
          const pageIndex = Math.min(doc.getPageCount() - 1, Math.max(0, parseInt((document.getElementById('pdf-split-range') as HTMLInputElement)?.value || '1', 10) - 1));
          const [copiedPage] = await splitDoc.copyPages(doc, [pageIndex]);
          splitDoc.addPage(copiedPage);
          const pdfBytes = await splitDoc.save();
          downloadPdf(pdfBytes, `page-${pageIndex + 1}-${loadedFiles[0].name}`);
        } else if (slug === 'jpg-to-pdf') {
          const pdfDoc = await PDFDocument.create();
          for (const file of loadedFiles) {
            const imgBytes = await file.arrayBuffer();
            const img = await pdfDoc.embedJpg(imgBytes);
            const page = pdfDoc.addPage([img.width, img.height]);
            page.drawImage(img, { x: 0, y: 0, width: img.width, height: img.height });
          }
          const pdfBytes = await pdfDoc.save();
          downloadPdf(pdfBytes, 'converted-images.pdf');
        } else {
          // Standard download or fallback
          const bytes = await loadedFiles[0].arrayBuffer();
          const doc = await PDFDocument.load(bytes);
          const pdfBytes = await doc.save();
          downloadPdf(pdfBytes, `kunda-${loadedFiles[0].name}`);
        }

        if (statusText) statusText.textContent = 'âœ“ Completed successfully!';
      } catch (err: any) {
        if (statusText) {
          statusText.textContent = `âœ— Error: ${err.message}`;
          statusText.className = 'text-xs font-semibold text-red-600 dark:text-red-400';
        }
      }
    });

    function downloadPdf(bytes: Uint8Array, filename: string) {
      const blob = new Blob([bytes as any], { type: 'application/pdf' });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = filename;
      a.click();
      URL.revokeObjectURL(url);
    }
  }
</script>

