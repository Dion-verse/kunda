---
import MainLayout from '@/layouts/MainLayout.astro';
---

<MainLayout
  title="Instant QR Code Generator | KUNDA Free Tools"
  description="Generate high-resolution customizable QR codes for links, text, and WiFi networks with instant SVG and PNG downloads."
  section="Tools"
>
  <div class="mx-auto max-w-[85rem] px-4 py-8 sm:px-6 lg:px-8 2xl:max-w-full">
    {/* Breadcrumbs */}
    <div class="mb-6 flex items-center gap-2 text-sm text-neutral-500 dark:text-neutral-400">
      <a href="/tools" class="hover:text-orange-600 transition-colors">Tools</a>
      <span>/</span>
      <span class="text-neutral-800 dark:text-neutral-200 font-medium">QR Code Generator</span>
    </div>

    {/* Header */}
    <div class="mb-8">
      <div class="flex flex-wrap items-center justify-between gap-4">
        <div>
          <h1 class="text-2xl font-extrabold tracking-tight text-neutral-900 md:text-3xl dark:text-neutral-100">
            Instant QR Code Generator
          </h1>
          <p class="mt-1 text-sm text-neutral-600 dark:text-neutral-400">
            Generate clean, scannable QR codes for web links, text, or contact info.
          </p>
        </div>
        <span class="inline-flex items-center gap-1.5 py-1 px-3 rounded-full text-xs font-semibold bg-emerald-100 text-emerald-800 dark:bg-emerald-950 dark:text-emerald-300">
          <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
          Free & Unlimited Export
        </span>
      </div>
    </div>

    {/* Main Grid */}
    <div class="grid grid-cols-1 gap-8 lg:grid-cols-2">
      {/* Input Options */}
      <div class="space-y-6">
        <div class="rounded-2xl border border-neutral-200 bg-white p-6 shadow-xs dark:border-neutral-800 dark:bg-neutral-900">
          <label for="qr-data" class="block text-sm font-semibold text-neutral-800 dark:text-neutral-200 mb-2">
            URL or Text Content
          </label>
          <input
            id="qr-data"
            type="text"
            value="https://kunda.works"
            placeholder="https://yourwebsite.com or text..."
            class="w-full rounded-xl border border-neutral-300 bg-neutral-50 px-4 py-3 text-sm text-neutral-900 focus:border-orange-500 focus:bg-white focus:ring-2 focus:ring-orange-500/20 dark:border-neutral-700 dark:bg-neutral-800 dark:text-neutral-100"
          />

          <div class="mt-6 grid grid-cols-2 gap-4">
            <div>
              <label for="qr-size" class="block text-xs font-semibold text-neutral-600 dark:text-neutral-400 mb-2">
                Output Size (Pixels)
              </label>
              <select
                id="qr-size"
                class="w-full rounded-xl border border-neutral-300 bg-neutral-50 px-3 py-2 text-xs text-neutral-900 dark:border-neutral-700 dark:bg-neutral-800 dark:text-neutral-100"
              >
                <option value="200">200 x 200 px</option>
                <option value="300" selected>300 x 300 px</option>
                <option value="400">400 x 400 px</option>
                <option value="600">600 x 600 px (HD)</option>
              </select>
            </div>
            <div>
              <label for="qr-color" class="block text-xs font-semibold text-neutral-600 dark:text-neutral-400 mb-2">
                Primary Color
              </label>
              <div class="flex items-center gap-2">
                <input
                  id="qr-color"
                  type="color"
                  value="#202723"
                  class="h-9 w-14 rounded-lg cursor-pointer border border-neutral-300 dark:border-neutral-700 bg-transparent"
                />
                <span class="text-xs font-mono text-neutral-500">Hex</span>
              </div>
            </div>
          </div>
        </div>
      </div>

      {/* Preview & Download Panel */}
      <div class="flex flex-col items-center justify-center rounded-2xl border border-neutral-200 bg-white p-8 shadow-xs dark:border-neutral-800 dark:bg-neutral-900">
        <div id="qr-preview" class="p-4 rounded-xl border border-neutral-100 bg-white shadow-xs dark:border-neutral-800 flex items-center justify-center min-h-[260px] min-w-[260px]">
          <img
            id="qr-image"
            src=""
            alt="Generated QR Code"
            class="max-w-[240px] max-h-[240px] rounded-lg"
          />
        </div>

        <div class="mt-6 flex flex-wrap gap-3">
          <button
            id="btn-download"
            type="button"
            class="rounded-xl bg-orange-600 px-5 py-2.5 text-xs font-semibold text-white shadow-xs hover:bg-orange-700 transition-colors"
          >
            Download PNG Image
          </button>
        </div>
      </div>
    </div>
  </div>


  <script is:inline>
    const qrData = document.getElementById('qr-data');
    const qrSize = document.getElementById('qr-size');
    const qrColor = document.getElementById('qr-color');
    const qrImage = document.getElementById('qr-image');
    const downloadBtn = document.getElementById('btn-download');

    function updateQR() {
      const text = encodeURIComponent(qrData.value.trim() || 'https://kunda.works');
      const size = qrSize.value;
      const color = qrColor.value.replace('#', '');
      const url = `https://api.qrserver.com/v1/create-qr-code/?size=${size}x${size}&data=${text}&color=${color}&bgcolor=ffffff&margin=1`;
      qrImage.src = url;
    }

    qrData?.addEventListener('input', updateQR);
    qrSize?.addEventListener('change', updateQR);
    qrColor?.addEventListener('input', updateQR);

    downloadBtn?.addEventListener('click', async () => {
      try {
        const res = await fetch(qrImage.src);
        const blob = await res.blob();
        const blobUrl = URL.createObjectURL(blob);
        const link = document.createElement('a');
        link.href = blobUrl;
        link.download = `kunda-qr-${Date.now()}.png`;
        document.body.appendChild(link);
        link.click();
        document.body.removeChild(link);
        URL.revokeObjectURL(blobUrl);
      } catch (err) {
        window.open(qrImage.src, '_blank');
      }
    });

    updateQR();
  </script>
</MainLayout>

