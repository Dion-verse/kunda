---
import MainLayout from '@/layouts/MainLayout.astro';
---

<MainLayout
  title="Password Strength & Entropy Analyzer | KUNDA Free Tools"
  description="Check password complexity, calculate cryptographic entropy bits, and estimate brute-force crack time securely in your browser."
  section="Tools"
>
  <div class="mx-auto max-w-[85rem] px-4 py-8 sm:px-6 lg:px-8 2xl:max-w-full">
    {/* Breadcrumbs */}
    <div class="mb-6 flex items-center gap-2 text-sm text-neutral-500 dark:text-neutral-400">
      <a href="/tools" class="hover:text-orange-600 transition-colors">Tools</a>
      <span>/</span>
      <span class="text-neutral-800 dark:text-neutral-200 font-medium">Password Analyzer</span>
    </div>

    {/* Header */}
    <div class="mb-8">
      <div class="flex flex-wrap items-center justify-between gap-4">
        <div>
          <h1 class="text-2xl font-extrabold tracking-tight text-neutral-900 md:text-3xl dark:text-neutral-100">
            Password Strength & Entropy Analyzer
          </h1>
          <p class="mt-1 text-sm text-neutral-600 dark:text-neutral-400">
            Test password resilience and calculate cryptographic entropy. No data is stored or transmitted.
          </p>
        </div>
        <span class="inline-flex items-center gap-1.5 py-1 px-3 rounded-full text-xs font-semibold bg-emerald-100 text-emerald-800 dark:bg-emerald-950 dark:text-emerald-300">
          <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
          Zero Network Transmission
        </span>
      </div>
    </div>

    {/* Main Container */}
    <div class="grid grid-cols-1 gap-8 lg:grid-cols-3">
      {/* Input & Score Section */}
      <div class="lg:col-span-2 space-y-6">
        <div class="rounded-2xl border border-neutral-200 bg-white p-6 shadow-xs dark:border-neutral-800 dark:bg-neutral-900">
          <label for="password-input" class="block text-sm font-semibold text-neutral-800 dark:text-neutral-200 mb-2">
            Enter Password to Analyze
          </label>
          <div class="relative">
            <input
              id="password-input"
              type="password"
              placeholder="Type or paste a password..."
              class="w-full rounded-xl border border-neutral-300 bg-neutral-50 px-4 py-3.5 pr-20 text-base font-mono text-neutral-900 focus:border-orange-500 focus:bg-white focus:ring-2 focus:ring-orange-500/20 dark:border-neutral-700 dark:bg-neutral-800 dark:text-neutral-100"
            />
            <button
              id="btn-toggle-visibility"
              type="button"
              class="absolute right-3 top-1/2 -translate-y-1/2 rounded-lg px-2.5 py-1.5 text-xs font-semibold text-neutral-600 hover:bg-neutral-200 dark:text-neutral-400 dark:hover:bg-neutral-700"
            >
              Show
            </button>
          </div>

          {/* Strength Meter Bar */}
          <div class="mt-6">
            <div class="flex items-center justify-between text-xs font-semibold mb-2">
              <span class="text-neutral-600 dark:text-neutral-400">Strength Rating</span>
              <span id="strength-label" class="text-neutral-500">Enter a password</span>
            </div>
            <div class="h-2.5 w-full rounded-full bg-neutral-100 overflow-hidden dark:bg-neutral-800">
              <div id="strength-bar" class="h-full w-0 rounded-full transition-all duration-300 bg-neutral-300"></div>
            </div>
          </div>

          {/* Metrics Grid */}
          <div class="mt-6 grid grid-cols-2 gap-4 sm:grid-cols-3 border-t border-neutral-100 pt-6 dark:border-neutral-800">
            <div>
              <span class="text-xs text-neutral-500">Entropy</span>
              <p id="entropy-value" class="text-xl font-extrabold text-neutral-900 dark:text-neutral-100">0 bits</p>
            </div>
            <div>
              <span class="text-xs text-neutral-500">Character Length</span>
              <p id="length-value" class="text-xl font-extrabold text-neutral-900 dark:text-neutral-100">0</p>
            </div>
            <div>
              <span class="text-xs text-neutral-500">Est. Brute-Force Time</span>
              <p id="crack-time" class="text-xl font-extrabold text-neutral-900 dark:text-neutral-100">Instant</p>
            </div>
          </div>
        </div>

        {/* Password Generator */}
        <div class="rounded-2xl border border-neutral-200 bg-white p-6 shadow-xs dark:border-neutral-800 dark:bg-neutral-900">
          <h2 class="text-lg font-bold text-neutral-900 dark:text-neutral-100 mb-4">
            Generate Secure Password
          </h2>
          <div class="flex flex-wrap items-center gap-4">
            <div class="flex-1 min-w-[200px]">
              <div class="flex justify-between text-xs font-semibold text-neutral-600 dark:text-neutral-400 mb-1">
                <span>Length</span>
                <span id="gen-length-display">16 chars</span>
              </div>
              <input
                id="gen-length"
                type="range"
                min="8"
                max="32"
                value="16"
                class="w-full accent-orange-600"
              />
            </div>
            <button
              id="btn-generate"
              type="button"
              class="rounded-xl bg-orange-600 px-5 py-3 text-sm font-semibold text-white hover:bg-orange-700 transition-colors"
            >
              Generate New Password
            </button>
          </div>
        </div>
      </div>

      {/* Checklist Breakdown */}
      <div class="rounded-2xl border border-neutral-200 bg-white p-6 shadow-xs dark:border-neutral-800 dark:bg-neutral-900">
        <h3 class="text-base font-bold text-neutral-900 dark:text-neutral-100 mb-4">
          Complexity Checklist
        </h3>
        <ul class="space-y-3 text-sm">
          <li id="check-length" class="flex items-center gap-2.5 text-neutral-400">
            <span class="w-4 h-4 rounded-full border border-current flex items-center justify-center text-[10px]">&times;</span>
            <span>At least 12 characters</span>
          </li>
          <li id="check-upper" class="flex items-center gap-2.5 text-neutral-400">
            <span class="w-4 h-4 rounded-full border border-current flex items-center justify-center text-[10px]">&times;</span>
            <span>Uppercase letters (A-Z)</span>
          </li>
          <li id="check-lower" class="flex items-center gap-2.5 text-neutral-400">
            <span class="w-4 h-4 rounded-full border border-current flex items-center justify-center text-[10px]">&times;</span>
            <span>Lowercase letters (a-z)</span>
          </li>
          <li id="check-numbers" class="flex items-center gap-2.5 text-neutral-400">
            <span class="w-4 h-4 rounded-full border border-current flex items-center justify-center text-[10px]">&times;</span>
            <span>Numbers (0-9)</span>
          </li>
          <li id="check-symbols" class="flex items-center gap-2.5 text-neutral-400">
            <span class="w-4 h-4 rounded-full border border-current flex items-center justify-center text-[10px]">&times;</span>
            <span>Symbols (!@#$%^&*)</span>
          </li>
        </ul>
      </div>
    </div>
  </div>


  <script is:inline>
    const input = document.getElementById('password-input');
    const toggleBtn = document.getElementById('btn-toggle-visibility');
    const strengthBar = document.getElementById('strength-bar');
    const strengthLabel = document.getElementById('strength-label');
    const entropyVal = document.getElementById('entropy-value');
    const lengthVal = document.getElementById('length-value');
    const crackTimeVal = document.getElementById('crack-time');

    const checkLength = document.getElementById('check-length');
    const checkUpper = document.getElementById('check-upper');
    const checkLower = document.getElementById('check-lower');
    const checkNumbers = document.getElementById('check-numbers');
    const checkSymbols = document.getElementById('check-symbols');

    function updateCheck(el, passed) {
      if (!el) return;
      if (passed) {
        el.classList.remove('text-neutral-400');
        el.classList.add('text-emerald-600', 'font-medium');
        el.firstElementChild.textContent = '✓';
      } else {
        el.classList.remove('text-emerald-600', 'font-medium');
        el.classList.add('text-neutral-400');
        el.firstElementChild.textContent = '×';
      }
    }

    function calculateEntropy(pwd) {
      let poolSize = 0;
      if (/[a-z]/.test(pwd)) poolSize += 26;
      if (/[A-Z]/.test(pwd)) poolSize += 26;
      if (/[0-9]/.test(pwd)) poolSize += 10;
      if (/[^a-zA-Z0-9]/.test(pwd)) poolSize += 33;
      if (poolSize === 0 || pwd.length === 0) return 0;
      return Math.round(pwd.length * Math.log2(poolSize));
    }

    function getCrackTime(entropy) {
      if (entropy === 0) return 'Instant';
      if (entropy < 28) return '< 1 second';
      if (entropy < 36) return 'A few seconds';
      if (entropy < 50) return 'A few hours';
      if (entropy < 65) return 'Several months';
      if (entropy < 80) return 'Centuries';
      return 'Trillions of years';
    }

    function analyze() {
      const pwd = input.value;
      const len = pwd.length;
      lengthVal.textContent = len;

      const hasUpper = /[A-Z]/.test(pwd);
      const hasLower = /[a-z]/.test(pwd);
      const hasNum = /[0-9]/.test(pwd);
      const hasSym = /[^a-zA-Z0-9]/.test(pwd);

      updateCheck(checkLength, len >= 12);
      updateCheck(checkUpper, hasUpper);
      updateCheck(checkLower, hasLower);
      updateCheck(checkNumbers, hasNum);
      updateCheck(checkSymbols, hasSym);

      const entropy = calculateEntropy(pwd);
      entropyVal.textContent = `${entropy} bits`;
      crackTimeVal.textContent = getCrackTime(entropy);

      if (len === 0) {
        strengthBar.style.width = '0%';
        strengthBar.className = 'h-full rounded-full transition-all duration-300 bg-neutral-300';
        strengthLabel.textContent = 'Enter a password';
        strengthLabel.className = 'text-neutral-500';
      } else if (entropy < 30) {
        strengthBar.style.width = '20%';
        strengthBar.className = 'h-full rounded-full transition-all duration-300 bg-red-500';
        strengthLabel.textContent = 'Very Weak';
        strengthLabel.className = 'text-red-500';
      } else if (entropy < 50) {
        strengthBar.style.width = '45%';
        strengthBar.className = 'h-full rounded-full transition-all duration-300 bg-orange-500';
        strengthLabel.textContent = 'Moderate';
        strengthLabel.className = 'text-orange-500';
      } else if (entropy < 70) {
        strengthBar.style.width = '75%';
        strengthBar.className = 'h-full rounded-full transition-all duration-300 bg-yellow-500';
        strengthLabel.textContent = 'Strong';
        strengthLabel.className = 'text-yellow-600';
      } else {
        strengthBar.style.width = '100%';
        strengthBar.className = 'h-full rounded-full transition-all duration-300 bg-emerald-500';
        strengthLabel.textContent = 'Very Strong';
        strengthLabel.className = 'text-emerald-600';
      }
    }

    toggleBtn?.addEventListener('click', () => {
      if (input.type === 'password') {
        input.type = 'text';
        toggleBtn.textContent = 'Hide';
      } else {
        input.type = 'password';
        toggleBtn.textContent = 'Show';
      }
    });

    input?.addEventListener('input', analyze);

    // Generator logic
    const genLength = document.getElementById('gen-length');
    const genLengthDisplay = document.getElementById('gen-length-display');
    const genBtn = document.getElementById('btn-generate');

    genLength?.addEventListener('input', () => {
      genLengthDisplay.textContent = `${genLength.value} chars`;
    });

    genBtn?.addEventListener('click', () => {
      const len = parseInt(genLength.value, 10);
      const chars = 'abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789!@#$%^&*()-_=+[]{}|;:,.<>?';
      let generated = '';
      const array = new Uint32Array(len);
      window.crypto.getRandomValues(array);
      for (let i = 0; i < len; i++) {
        generated += chars[array[i] % chars.length];
      }
      input.value = generated;
      analyze();
    });
  </script>
</MainLayout>

