---
import MainLayout from '@/layouts/MainLayout.astro';
import PrimaryCTA from '@components/ui/buttons/PrimaryCTA.astro';
import { CATEGORIES, TOOLS } from '@/data/tools';
import ToolCard from '@/components/tools/ToolCard.astro';
import ToolCategoryCard from '@/components/tools/ToolCategoryCard.astro';
import ToolSearch from '@/components/tools/ToolSearch.astro';
import ToolFilters from '@/components/tools/ToolFilters.astro';

const totalTools = TOOLS.length;
---

<MainLayout
  title="All-in-One Online Tools Platform (49 Tools) | KUNDA"
  description="High-performance, privacy-first interactive tools engineered for creators, businesses and developers. 100% browser-based with zero data uploads."
  section="Tools"
>
  <div class="mx-auto max-w-[85rem] px-4 py-8 sm:px-6 lg:px-8 lg:py-12 2xl:max-w-full space-y-12">
    {/* Page Header strictly matching Homepage / Products UI/UX */}
    <div class="flex flex-col justify-between gap-6 sm:flex-row sm:items-center">
      <div class="flex items-center gap-6 md:gap-12">
        <div>
          <div class="mb-2 inline-flex items-center gap-2 rounded-full bg-orange-100 px-3 py-1 text-xs font-semibold text-orange-800 dark:bg-orange-950 dark:text-orange-300">
            <span class="inline-block h-2 w-2 rounded-full bg-orange-500 animate-pulse"></span>
            6 Categories Â· {totalTools} In-Browser Utilities
          </div>
          <h1 class="text-3xl font-extrabold tracking-tight text-neutral-800 sm:text-4xl md:text-5xl dark:text-neutral-100">
            All-in-One Tools Platform
          </h1>
          <p class="mt-2 max-w-2xl text-sm text-neutral-600 sm:text-base dark:text-neutral-400">
            Fast, deterministic tools engineered to eliminate operational friction. No cloud queues, no telemetry, no tracking â€” your files and payloads never leave your browser memory.
          </p>
        </div>
      </div>
      <div class="shrink-0 flex items-center gap-3">
        <PrimaryCTA
          title="Browse Products"
          url="/products"
          noArrow={true}
        />
      </div>
    </div>

    {/* Search Component */}
    <ToolSearch />

    {/* Category Quick Filter Pills */}
    <ToolFilters activeCategory="all" />

    {/* Category Showcase Grid */}
    <section>
      <div class="mb-6 flex items-center justify-between">
        <h2 class="text-xl font-bold text-neutral-800 dark:text-neutral-100">
          Browse by Category
        </h2>
        <span class="text-xs font-semibold text-neutral-500">6 Specialized Domains</span>
      </div>
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {CATEGORIES.map(category => (
          <ToolCategoryCard category={category} />
        ))}
      </div>
    </section>

    {/* All Tools Grid (with client-side interactive search & category filter) */}
    <section id="tools-catalog">
      <div class="mb-6 flex items-center justify-between border-b border-neutral-200/80 pb-4 dark:border-neutral-700/60">
        <div>
          <h2 class="text-xl font-bold text-neutral-800 dark:text-neutral-100">
            Complete Tool Directory
          </h2>
          <p class="text-xs text-neutral-500 mt-0.5">
            Filter or search to access any of our {totalTools} utilities instantly.
          </p>
        </div>
        <span class="text-xs font-medium text-emerald-600 dark:text-emerald-400 flex items-center gap-1.5">
          <span class="inline-block h-2 w-2 rounded-full bg-emerald-500"></span>
          100% In-Browser Execution
        </span>
      </div>

      <div
        id="tools-grid-container"
        class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4"
      >
        {TOOLS.map(tool => (
          <div
            class="tool-grid-item"
            data-slug={tool.slug}
            data-category={tool.category}
            data-title={tool.title.toLowerCase()}
            data-desc={tool.description.toLowerCase()}
            data-tags={tool.tags.join(' ').toLowerCase()}
          >
            <ToolCard tool={tool} />
          </div>
        ))}
      </div>

      {/* No Results Fallback */}
      <div
        id="no-tools-found"
        class="hidden flex-col items-center justify-center rounded-2xl border border-dashed border-neutral-300 py-16 text-center dark:border-neutral-700"
      >
        <p class="text-base font-bold text-neutral-700 dark:text-neutral-300">
          No matching tools found
        </p>
        <p class="mt-1 text-xs text-neutral-500">
          Try adjusting your search terms or selecting a different category.
        </p>
        <button
          type="button"
          id="reset-search-btn"
          class="mt-4 rounded-xl bg-orange-500 px-4 py-2 text-xs font-bold text-white hover:bg-orange-600 transition"
        >
          Reset Filters
        </button>
      </div>
    </section>

    {/* Privacy & Zero-Knowledge Architecture Assurance */}
    <section class="rounded-2xl border border-neutral-200/80 bg-neutral-50/70 p-8 dark:border-neutral-700/60 dark:bg-neutral-800/40">
      <div class="grid gap-6 md:grid-cols-3">
        <div class="space-y-2">
          <div class="flex items-center gap-2 text-orange-500 font-bold text-sm">
            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
            </svg>
            Zero-Knowledge Design
          </div>
          <p class="text-xs text-neutral-600 dark:text-neutral-400 leading-relaxed">
            All algorithms, from PDF-lib document merges to Canvas image transforms and cryptographically secure UUIDs, execute strictly inside your local browser sandbox.
          </p>
        </div>

        <div class="space-y-2">
          <div class="flex items-center gap-2 text-emerald-600 dark:text-emerald-400 font-bold text-sm">
            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
            </svg>
            Offline Capable
          </div>
          <p class="text-xs text-neutral-600 dark:text-neutral-400 leading-relaxed">
            Once loaded, our tools function completely offline. You can disconnect your network connection and still format JSON, calculate loans, and convert images safely.
          </p>
        </div>

        <div class="space-y-2">
          <div class="flex items-center gap-2 text-teal-600 dark:text-teal-400 font-bold text-sm">
            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
            </svg>
            Open Web Standards
          </div>
          <p class="text-xs text-neutral-600 dark:text-neutral-400 leading-relaxed">
            Constructed with standard Web APIs (Canvas, FileReader, Crypto, Web Workers). Free of tracking pixels, analytical eavesdropping, and enterprise paywalls.
          </p>
        </div>
      </div>
    </section>
  </div>
</MainLayout>

<script>
  import Fuse from 'fuse.js';
  import { TOOLS } from '@/data/tools';

  const searchInput = document.getElementById('tool-search-input') as HTMLInputElement | null;
  const searchClear = document.getElementById('tool-search-clear');
  const resultsCount = document.getElementById('tool-results-count');
  const items = Array.from(document.querySelectorAll('.tool-grid-item')) as HTMLElement[];
  const noFound = document.getElementById('no-tools-found');
  const resetBtn = document.getElementById('reset-search-btn');
  const filterBtns = Array.from(document.querySelectorAll('.tool-filter-btn')) as HTMLButtonElement[];

  let activeCategory = 'all';
  let searchQuery = '';

  // Initialize Fuse.js for fuzzy search with typo tolerance
  const fuse = new Fuse(TOOLS, {
    keys: ['title', 'description', 'category', 'tags'],
    threshold: 0.35,
    distance: 100,
    ignoreLocation: true,
  });

  function applyFilters() {
    let matchedSlugs: Set<string> | null = null;

    if (searchQuery.trim().length > 0) {
      const results = fuse.search(searchQuery.trim());
      matchedSlugs = new Set(results.map(r => r.item.slug));
    }

    let visibleCount = 0;
    items.forEach(el => {
      const slug = el.getAttribute('data-slug') || '';
      const cat = el.getAttribute('data-category') || '';

      const matchesCat = activeCategory === 'all' || cat === activeCategory;
      const matchesSearch = matchedSlugs === null || matchedSlugs.has(slug);

      if (matchesCat && matchesSearch) {
        el.style.display = '';
        visibleCount++;
      } else {
        el.style.display = 'none';
      }
    });

    if (resultsCount) {
      resultsCount.textContent = `Showing ${visibleCount} of ${items.length} tools`;
    }

    if (noFound) {
      if (visibleCount === 0) noFound.classList.remove('hidden');
      else noFound.classList.add('hidden');
    }
  }

  // Keyboard shortcut: / focuses search
  window.addEventListener('keydown', e => {
    if (e.key === '/' && document.activeElement !== searchInput) {
      e.preventDefault();
      searchInput?.focus();
    }
    if (e.key === 'Escape' && document.activeElement === searchInput) {
      if (searchInput) searchInput.value = '';
      searchQuery = '';
      searchClear?.classList.add('hidden');
      applyFilters();
    }
  });

  searchInput?.addEventListener('input', () => {
    searchQuery = searchInput.value;
    if (searchQuery.length > 0) searchClear?.classList.remove('hidden');
    else searchClear?.classList.add('hidden');
    applyFilters();
  });

  searchClear?.addEventListener('click', () => {
    if (searchInput) searchInput.value = '';
    searchQuery = '';
    searchClear.classList.add('hidden');
    applyFilters();
    searchInput?.focus();
  });

  filterBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      const filter = btn.getAttribute('data-filter') || 'all';
      activeCategory = filter;

      filterBtns.forEach(b => {
        b.className = 'tool-filter-btn rounded-xl px-4 py-2 text-sm font-semibold transition bg-neutral-100 text-neutral-700 hover:bg-neutral-200 dark:bg-neutral-800 dark:text-neutral-300 dark:hover:bg-neutral-700';
      });
      btn.className = 'tool-filter-btn rounded-xl px-4 py-2 text-sm font-semibold transition bg-orange-500 text-white shadow-md shadow-orange-500/20';

      applyFilters();
    });
  });

  resetBtn?.addEventListener('click', () => {
    if (searchInput) searchInput.value = '';
    searchQuery = '';
    activeCategory = 'all';
    searchClear?.classList.add('hidden');

    filterBtns.forEach(b => {
      const isAll = b.getAttribute('data-filter') === 'all';
      b.className = isAll
        ? 'tool-filter-btn rounded-xl px-4 py-2 text-sm font-semibold transition bg-orange-500 text-white shadow-md shadow-orange-500/20'
        : 'tool-filter-btn rounded-xl px-4 py-2 text-sm font-semibold transition bg-neutral-100 text-neutral-700 hover:bg-neutral-200 dark:bg-neutral-800 dark:text-neutral-300 dark:hover:bg-neutral-700';
    });

    applyFilters();
  });
</script>
