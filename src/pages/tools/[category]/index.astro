---
import MainLayout from '@/layouts/MainLayout.astro';
import { CATEGORIES, toolsByCategory, type ToolCategory } from '@/data/tools';
import ToolCard from '@/components/tools/ToolCard.astro';

export function getStaticPaths() {
  return CATEGORIES.map(category => ({
    params: { category: category.id },
    props: { category },
  }));
}

const { category } = Astro.props;
const tools = toolsByCategory(category.id as ToolCategory);

const pageTitle = `${category.label} â€” Free In-Browser Digital Utilities | KUNDA`;
const pageDescription = `${category.description} 100% private, client-side execution in your browser with zero data uploads.`;
---

<MainLayout
  title={pageTitle}
  description={pageDescription}
  section="Tools"
>
  <script
    type="application/ld+json"
    is:inline
    set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'CollectionPage',
      name: category.label,
      description: category.description,
      url: `https://kunda.works/tools/${category.id}`,
    })}
  />
  <div class="mx-auto max-w-[85rem] px-4 py-8 sm:px-6 lg:px-8 2xl:max-w-full">
    {/* Breadcrumbs */}
    <nav class="mb-6 flex items-center gap-2 text-xs text-neutral-500 dark:text-neutral-400" aria-label="Breadcrumb">
      <a href="/" class="hover:text-neutral-700 dark:hover:text-neutral-200">Home</a>
      <span>/</span>
      <a href="/tools" class="hover:text-neutral-700 dark:hover:text-neutral-200">Tools</a>
      <span>/</span>
      <span class="font-medium text-neutral-800 dark:text-neutral-200">{category.label}</span>
    </nav>

    {/* Category Header */}
    <div class="mb-10 flex flex-col justify-between gap-6 border-b border-neutral-200/80 pb-8 sm:flex-row sm:items-center dark:border-neutral-700/60">
      <div class="flex items-start gap-4">
        <span class={`flex h-14 w-14 shrink-0 items-center justify-center rounded-2xl text-3xl shadow-sm ${category.bgColor} ${category.darkBgColor}`}>
          {category.icon}
        </span>
        <div>
          <div class="flex items-center gap-2.5">
            <h1 class="text-2xl font-bold tracking-tight text-neutral-800 sm:text-3xl dark:text-neutral-100">
              {category.label}
            </h1>
            <span class="rounded-full bg-neutral-100 px-2.5 py-0.5 text-xs font-semibold text-neutral-600 dark:bg-neutral-800 dark:text-neutral-300">
              {tools.length} Tools
            </span>
          </div>
          <p class="mt-1.5 max-w-2xl text-sm text-neutral-600 sm:text-base dark:text-neutral-400">
            {category.description}
          </p>
        </div>
      </div>

      <a
        href="/tools"
        class="inline-flex items-center gap-1.5 rounded-xl border border-neutral-200 bg-white px-4 py-2 text-xs font-semibold text-neutral-700 shadow-xs hover:border-neutral-300 hover:bg-neutral-50 dark:border-neutral-700 dark:bg-neutral-800 dark:text-neutral-300 dark:hover:bg-neutral-700/70"
      >
        â† All Categories
      </a>
    </div>

    {/* Category Tools Grid */}
    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
      {tools.map(tool => (
        <ToolCard tool={tool} />
      ))}
    </div>

    {/* Privacy & Architecture Guarantee Banner */}
    <div class="mt-16 rounded-2xl border border-neutral-200/80 bg-neutral-50/80 p-6 sm:p-8 dark:border-neutral-700/60 dark:bg-neutral-800/40">
      <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
        <div class="flex items-center gap-3">
          <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-emerald-100 text-emerald-600 dark:bg-emerald-950 dark:text-emerald-400">
            <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
            </svg>
          </div>
          <div>
            <h3 class="text-sm font-bold text-neutral-800 dark:text-neutral-200">
              Deterministic Browser Execution
            </h3>
            <p class="text-xs text-neutral-600 dark:text-neutral-400">
              All {category.label} process data locally in your browser memory via WebAssembly and Canvas APIs. Zero tracking, zero telemetry, zero cloud uploads.
            </p>
          </div>
        </div>

        <a
          href="/contact"
          class="shrink-0 text-xs font-semibold text-orange-500 hover:text-orange-600 dark:text-orange-400"
        >
          Request a custom tool â†’
        </a>
      </div>
    </div>
  </div>
</MainLayout>
