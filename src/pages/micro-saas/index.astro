---
import MainLayout from '@/layouts/MainLayout.astro';
import PrimaryCTA from '@components/ui/buttons/PrimaryCTA.astro';
import SecondaryCTA from '@components/ui/buttons/SecondaryCTA.astro';
import Icon from '@components/ui/icons/Icon.astro';
---

<MainLayout
  title="Micro-SaaS"
  description="Focused, single-purpose software applications built for specific business bottlenecks under the KUNDA digital umbrella."
  section="Products"
>
  <div class="mx-auto max-w-[85rem] px-4 py-10 sm:px-6 lg:px-8 lg:py-14 2xl:max-w-full">
    {/* Page Header strictly matching Products layout */}
    <div class="mb-6 flex items-center justify-between gap-8 sm:mb-10 md:mb-12">
      <div class="flex items-center gap-12">
        <h1 class="text-2xl font-bold tracking-tight text-balance text-neutral-800 md:text-4xl md:leading-tight dark:text-neutral-200">
          Micro-SaaS
        </h1>
        <p class="hidden max-w-(--breakpoint-sm) text-pretty text-neutral-600 md:block dark:text-neutral-400">
          Targeted, lightweight software tools engineered to solve specific operational headaches without enterprise bloat.
        </p>
      </div>
      <PrimaryCTA
        title="Explore Free Tools"
        url="/tools"
        noArrow={true}
      />
    </div>

    {/* Incubator / In Development Announcement Card */}
    <div class="relative overflow-hidden rounded-xl border border-neutral-200 bg-white p-8 text-center shadow-lg md:p-14 dark:border-neutral-700/60 dark:bg-neutral-800/80">
      <div class="mx-auto max-w-2xl">
        <span class="inline-flex items-center gap-2 rounded-full bg-orange-100 px-3.5 py-1 text-xs font-semibold text-orange-800 dark:bg-orange-950 dark:text-orange-300">
          <span class="inline-block h-2 w-2 rounded-full bg-orange-500 animate-pulse"></span>
          KUNDA Software Lab & Incubator
        </span>
        <h2 class="mt-5 text-2xl font-bold tracking-tight text-neutral-800 md:text-3xl dark:text-neutral-100">
          Micro-SaaS Applications in Active Development
        </h2>
        <p class="mt-3 text-pretty text-base text-neutral-600 leading-relaxed dark:text-neutral-400">
          We are engineering single-purpose, high-impact web utilities designed to eliminate specific business bottlenecks. New tools will be released here progressively as they pass rigorous security and performance testing.
        </p>
        <div class="mt-8 flex flex-wrap items-center justify-center gap-4">
          <PrimaryCTA
            title="Request a Custom Tool"
            url="/contact"
          />
          <SecondaryCTA
            title="Browse Free Online Tools"
            url="/tools"
          />
        </div>
      </div>
    </div>

    {/* Architectural Principles Grid */}
    <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3 md:mt-16">
      <div class="rounded-xl border border-neutral-200 bg-white p-6 shadow-sm dark:border-neutral-700/60 dark:bg-neutral-800/60">
        <div class="flex items-center gap-3 mb-3">
          <div class="flex h-10 w-10 items-center justify-center rounded-lg bg-orange-500/10 text-orange-600 dark:bg-orange-500/20 dark:text-orange-400">
            <Icon name="rocket" class="h-5 w-5" />
          </div>
          <h3 class="text-lg font-bold text-neutral-800 dark:text-neutral-200">
            Zero Enterprise Bloat
          </h3>
        </div>
        <p class="text-sm text-neutral-600 leading-relaxed dark:text-neutral-400">
          Each application tackles exactly one workflow bottleneck with maximum speed, zero redundant menus, and no unnecessary monthly overhead.
        </p>
      </div>

      <div class="rounded-xl border border-neutral-200 bg-white p-6 shadow-sm dark:border-neutral-700/60 dark:bg-neutral-800/60">
        <div class="flex items-center gap-3 mb-3">
          <div class="flex h-10 w-10 items-center justify-center rounded-lg bg-orange-500/10 text-orange-600 dark:bg-orange-500/20 dark:text-orange-400">
            <Icon name="verified" class="h-5 w-5" />
          </div>
          <h3 class="text-lg font-bold text-neutral-800 dark:text-neutral-200">
            Privacy & Edge Architecture
          </h3>
        </div>
        <p class="text-sm text-neutral-600 leading-relaxed dark:text-neutral-400">
          Deployed globally across Cloudflare edge workers for sub-50ms latency worldwide. Sensitive data stays encrypted and transparent.
        </p>
      </div>

      <div class="rounded-xl border border-neutral-200 bg-white p-6 shadow-sm dark:border-neutral-700/60 dark:bg-neutral-800/60">
        <div class="flex items-center gap-3 mb-3">
          <div class="flex h-10 w-10 items-center justify-center rounded-lg bg-orange-500/10 text-orange-600 dark:bg-orange-500/20 dark:text-orange-400">
            <Icon name="sparks" class="h-5 w-5" />
          </div>
          <h3 class="text-lg font-bold text-neutral-800 dark:text-neutral-200">
            Direct Founder Support
          </h3>
        </div>
        <p class="text-sm text-neutral-600 leading-relaxed dark:text-neutral-400">
          Built and maintained by independent builders. Feature requests and roadmap inputs are reviewed directly by the core engineering team.
        </p>
      </div>
    </div>
  </div>
</MainLayout>
